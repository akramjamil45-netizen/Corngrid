<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- Preserve API JSON errors; ExecuteURL error pages can turn POST 503 into 404. -->
  <location path="api">
    <system.webServer>
      <httpErrors existingResponse="PassThrough" />
    </system.webServer>
  </location>
  <location path="sw.js">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
          <add name="Pragma" value="no-cache" />
          <add name="Expires" value="0" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <location path="index.html">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache, no-store, must-revalidate, no-transform" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <location path="en">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <remove name="Cache-Control" />
          <add name="Cache-Control" value="no-cache, no-store, must-revalidate, no-transform" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".apk" />
      <mimeMap fileExtension=".apk" mimeType="application/vnd.android.package-archive" />
    </staticContent>
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <remove statusCode="502" subStatusCode="-1" />
      <remove statusCode="503" subStatusCode="-1" />
      <remove statusCode="504" subStatusCode="-1" />
      <error statusCode="404" subStatusCode="-1" path="/service-unavailable" responseMode="ExecuteURL" />
      <error statusCode="502" subStatusCode="-1" path="/service-unavailable" responseMode="ExecuteURL" />
      <error statusCode="503" subStatusCode="-1" path="/service-unavailable" responseMode="ExecuteURL" />
      <error statusCode="504" subStatusCode="-1" path="/service-unavailable" responseMode="ExecuteURL" />
    </httpErrors>
    <rewrite>
      <rules>
        <rule name="CornGrid EA product" stopProcessing="true"><match url="^corngrid-ea/?$" /><action type="Rewrite" url="corngrid-ea.html" /></rule>
        <rule name="CornGrid English infrastructure" stopProcessing="true"><match url="^en/?$" /><action type="Rewrite" url="en/index.html" /></rule>
        <rule name="Static promotional homepage" stopProcessing="true">
          <match url="^$" />
          <action type="Rewrite" url="index.html" />
        </rule>
        <rule name="Static promotional page - Trading Terminal &amp; Android App" stopProcessing="true">
          <match url="^promote/terminal-app/?$" />
          <action type="Rewrite" url="promote/terminal-app/index.html" />
        </rule>
        <rule name="Static service unavailable page" stopProcessing="true">
          <match url="^service-unavailable/?$" />
          <action type="Rewrite" url="Corngrid-web/public/service-unavailable.html" />
        </rule>
        <rule name="Static service unavailable assets" stopProcessing="true">
          <match url="^service-unavailable\.(css|js)$" />
          <action type="Rewrite" url="Corngrid-web/public/service-unavailable.{R:1}" />
        </rule>
        <rule name="CornGrid-Sandbox-WebSocket" stopProcessing="true">
          <match url="^ws/admin/sandbox$" />
          <action type="Rewrite" url="http://127.0.0.1:3000/ws/admin/sandbox" appendQueryString="true" />
        </rule>
        <rule name="CornGrid Node backend" stopProcessing="true">
          <match url="^(/?api/.*|/?ws/.*|sandbox/?|sandbox\.js|mt5-brokers\.json|admin-sandbox\.js|partner/?|partner\.html|partner\.js|login/?|login\.html|verify-email/?|verify-email\.(?:html|css|js)|admin/?|admin\.html|admin\.css|admin\.js|dashboard\.html|dashboard\.css|dashboard\.js|table-cards\.js|market\.js|economic-news\.js|feed\.js|vendor/.*|uploads/.*|portfolios/?|portfolio/.*|public-portfolios(?:\.html|\.js)?|public-portfolio(?:\.html|\.js)?|reset-password(?:\.html|\.js)?|style\.css|login\.js|manifest\.webmanifest|offline\.html|pwa\.(?:css|js)|public-shell\.css|images/pwa-(?:192|512)\.png|favicon\.ico)$" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:0}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
