<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <location path="sw.js">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
          <add name="Pragma" value="no-cache" />
          <add name="Expires" value="0" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <location path="index.html">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <system.webServer>
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <remove statusCode="502" subStatusCode="-1" />
      <remove statusCode="503" subStatusCode="-1" />
      <remove statusCode="504" subStatusCode="-1" />
      <error statusCode="404" subStatusCode="-1" path="/service-unavailable" responseMode="ExecuteURL" />
      <error statusCode="502" subStatusCode="-1" path="/service-unavailable" responseMode="ExecuteURL" />
      <error statusCode="503" subStatusCode="-1" path="/service-unavailable" responseMode="ExecuteURL" />
      <error statusCode="504" subStatusCode="-1" path="/service-unavailable" responseMode="ExecuteURL" />
    </httpErrors>
    <rewrite>
      <rules>
        <rule name="Static promotional homepage" stopProcessing="true">
          <match url="^$" />
          <action type="Rewrite" url="index.html" />
        </rule>
        <rule name="Static service unavailable page" stopProcessing="true">
          <match url="^service-unavailable/?$" />
          <action type="Rewrite" url="Corngrid-web/public/service-unavailable.html" />
        </rule>
        <rule name="Static service unavailable assets" stopProcessing="true">
          <match url="^service-unavailable\.(css|js)$" />
          <action type="Rewrite" url="Corngrid-web/public/service-unavailable.{R:1}" />
        </rule>
        <rule name="CornGrid Node backend" stopProcessing="true">
          <match url="^(api/.*|login/?|login\.html|admin/?|admin\.html|admin\.css|admin\.js|dashboard\.html|dashboard\.css|dashboard\.js|market\.js|feed\.js|vendor/.*|uploads/.*|portfolios/?|portfolio/.*|public-portfolios(?:\.html|\.js)?|public-portfolio(?:\.html|\.js)?|reset-password(?:\.html|\.js)?|style\.css|login\.js|manifest\.webmanifest|offline\.html|pwa\.(?:css|js)|images/pwa-(?:192|512)\.png|favicon\.ico)$" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:0}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>