{
  "name": "corngrid-sandbox-agent",
  "version": "1.3.3",
  "description": "CornGrid Sandbox Agent - Windows and Linux/Wine MT5 hosting",
  "os": ["win32", "linux"],
  "main": "agent.js",
  "scripts": {
    "start": "node agent-launcher.js",
    "install:task": "powershell -ExecutionPolicy Bypass -File install-service.ps1",
    "uninstall:task": "powershell -ExecutionPolicy Bypass -File uninstall-service.ps1",
    "install:linux": "bash install-service.sh",
    "check": "node check-installation.js"
  },
  "engines": {
    "node": ">=20.17.0"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "ws": "^8.18.0"
  }
}
