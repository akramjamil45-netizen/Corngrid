# Database backend
# Set DATABASE_URL to a PostgreSQL connection string to use PostgreSQL.
# If unset, the app falls back to the local SQLite file at DATABASE_PATH.
# DATABASE_URL=postgres://user:password@localhost:5432/corngrid
# DATABASE_PATH=./database.sqlite
# SQLITE_PATH=./database.sqlite

NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
APP_BASE_URL=http://localhost:3000
MT5_HEARTBEAT_TIMEOUT_SECONDS=180

# Required in production when the app sits behind IIS/Cloudflare: makes req.ip the
# real client IP so per-IP rate limits and logs are correct. Use "1" for one proxy
# hop, or "true" / a subnet like "loopback" (Express trust-proxy syntax).
TRUST_PROXY=1

# Performance tuning (optional). Defaults suit a few hundred EA connections.
# UV_THREADPOOL_SIZE=16            # libuv worker threads; raise for more DB concurrency
# MT5_AUTH_CACHE_TTL_MS=5000       # cache EA installation auth lookups (0 = always hit the DB)
# MT5_SNAPSHOT_MIN_INTERVAL_SECONDS=60  # min seconds between balance-history rows per account (0 = every heartbeat)
# MT5_EA_IP_LIMIT=600              # coarse pre-auth per-IP EA request cap per minute
# DB_READ_POOL_SIZE=3              # read-only connections for SELECTs (0 = share the write connection)
# SLOW_REQUEST_LOG_MS=1000         # log requests slower than this (and every 5xx)
# WAL_CHECKPOINT_INTERVAL_MS=300000  # fold the SQLite WAL back into the main file
# MARKET_CANDLE_CLEANUP_INTERVAL_MS=60000  # how often a stored candle series is trimmed to its max length

# Rolling SQLite backups (recommended in production). Written to storage/backups/
# by default and kept outside the app's serving paths.
# BACKUP_DIR=./storage/backups
# BACKUP_INTERVAL_HOURS=24         # 0 disables scheduled backups
# BACKUP_KEEP=7                    # number of most-recent backups to retain

# Optional: Twelve Data API key for the Market Overview page (https://twelvedata.com — free tier).
# When unset, the dashboard falls back to public Yahoo Finance data (delayed, gold shown as GC=F futures).
TWELVE_DATA_API_KEY=

# Optional administrator login through the existing login page.
# Generate the bcrypt hash with: node -e "require('bcryptjs').hash(process.argv[1], 12).then(console.log)" "choose-a-long-password"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=replace-with-an-app-password
SMTP_FROM=CornGrid <your-email@example.com>

# Optional: Live market feed from CornGrid EA (see README "Live Market Feed").
# Freshness thresholds, measured from the server's receipt time of the EA's last update.
MARKET_LIVE_MAX_AGE_SECONDS=10
MARKET_DELAYED_MAX_AGE_SECONDS=30
MARKET_STALE_MAX_AGE_SECONDS=120
# Preferred broker feed (broker server name from the EA account) when several EAs publish; empty = healthiest/newest.
MARKET_PREFERRED_FEED=
# Set to "external" to allow Twelve Data / Yahoo as a labeled FALLBACK when no fresh EA feed exists. Empty = off.
MARKET_FALLBACK_PROVIDER=
# Optional broker symbol aliases, e.g. GOLD=XAUUSD,USTEC=NAS100
MARKET_SYMBOL_ALIASES=
# Server-Sent Events limits. The browser reconnects when the lifetime expires, which
# bounds connections held open by a buffering/dropping proxy.
# MARKET_SSE_MAX_CLIENTS=300
# MARKET_SSE_MAX_PER_USER=3
# MARKET_SSE_MAX_LIFETIME_SECONDS=120
# MARKET_STREAM_MIN_INTERVAL_MS=250

# Profile photos (see README). Files live outside public/ and are served by avatar-api.js.
# AVATAR_DIR=./storage/avatars
# AVATAR_MAX_BYTES=5242880
# AVATAR_MAX_DIMENSION=2048

# Optional: Economic News / Economic Calendar feed (Forex Factory via FairEconomy).
# The server caches the feed in SQLite and reuses it for up to REFRESH_MS; upstream
# rate-limits frequent requests, so keep the interval at 5 minutes or higher.
# ECONOMIC_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.xml
# ECONOMIC_CALENDAR_REFRESH_MS=300000
# ECONOMIC_CALENDAR_TIMEOUT_MS=12000
