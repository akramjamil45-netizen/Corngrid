# Copy to .env.staging in a SEPARATE staging checkout. Fill private values locally.
# Start through scripts/start-staging.js; never copy the production .env.
PORT=3100
DATABASE_PATH=platform.staging.sqlite
# Alternatively use a separate PostgreSQL database ending in _staging or _test:
DATABASE_URL=
JWT_SECRET=
SANDBOX_ENCRYPTION_KEY=
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD_HASH=
# Optional Stripe Sandbox credentials; live keys are rejected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Empty blocks every agent. Set only a newly registered, isolated DEMO node UID.
STAGING_DEMO_NODE_UID=
MARKET_FALLBACK_PROVIDER=disabled
