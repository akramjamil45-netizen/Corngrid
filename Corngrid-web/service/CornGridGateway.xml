<service>
  <id>CornGridGateway</id>
  <name>CornGrid Loopback Gateway</name>
  <description>Routes operational API and WebSocket traffic directly to CornGrid without consuming Windows client IIS request slots.</description>
  <executable>C:\Program Files\nodejs\node.exe</executable>
  <arguments>"%BASE%\iis-gateway.js"</arguments>
  <workingdirectory>%BASE%</workingdirectory>
  <startmode>Automatic</startmode>
  <delayedAutoStart />
  <depend>Tcpip</depend>
  <onfailure action="restart" delay="5 sec" />
  <onfailure action="restart" delay="15 sec" />
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>10 sec</stoptimeout>
  <logpath>%BASE%\logs</logpath>
  <log mode="roll-by-size"><sizeThreshold>1024</sizeThreshold><keepFiles>5</keepFiles></log>
</service>
